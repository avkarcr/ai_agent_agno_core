# Copy to .env (never commit real secrets)
AGNO_TELEMETRY=false
CORE_DB_PATH=.local/core.sqlite3
CORE_WATCHES_FILE=watchers.json
CORE_POLL_MINUTES=30
CORE_ANALYZE_CHANGES=false
CORE_MODEL_PROVIDER=ollama
CORE_OLLAMA_MODEL=qwen2.5:3b
CORE_OLLAMA_HOST=http://127.0.0.1:11434
# Cloud alternative: install .[openai] and set OPENAI_API_KEY
# CORE_MODEL_PROVIDER=openai
# CORE_OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# CORE_TELEGRAM_BOT_TOKEN=
# CORE_TELEGRAM_CHAT_ID=
